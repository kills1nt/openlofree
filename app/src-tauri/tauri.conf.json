{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openlofree",
  "version": "0.1.0",
  "identifier": "io.github.kills1nt.openlofree",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "openlofree",
        "width": 1180,
        "height": 780,
        "minWidth": 860,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "kills1nt",
    "category": "Utility",
    "shortDescription": "Configure Lofree Flow 2 keyboards",
    "longDescription": "Keymap, backlight and profiles for Lofree Flow 2 keyboards over USB (VIA). No driver, no custom firmware.",
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/70-openlofree.rules": "../../packaging/linux/70-openlofree.rules"
        },
        "postInstallScript": "../../packaging/linux/postinst.sh"
      },
      "rpm": {
        "files": {
          "/usr/lib/udev/rules.d/70-openlofree.rules": "../../packaging/linux/70-openlofree.rules"
        },
        "postInstallScript": "../../packaging/linux/postinst.sh"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
